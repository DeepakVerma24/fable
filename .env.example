# Copy to .env at the repo root. Every value here is a local default.
# Nothing in this file enables real-money transactions.

FABLE_ENV=dev
LOG_LEVEL=info

# Host ports published by docker compose. Inside the compose network the
# hostnames are postgres, pgbouncer, and redis.
# App runtime goes through PgBouncer. Migrations use the direct Postgres URL.
DATABASE_URL=postgresql://fable:fable@127.0.0.1:6432/fable?schema=public
DIRECT_DATABASE_URL=postgresql://fable:fable@127.0.0.1:54329/fable?schema=public
REDIS_URL=redis://127.0.0.1:63799

# API
PORT=4307
WEB_ORIGIN=http://127.0.0.1:3847,http://localhost:3847

# Optional. The process boots without these.
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Web (Next reads apps/web/.env*, not this file). The UI also falls back to this URL.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4307

# Set to 1 only when Docker is available and @testcontainers/postgresql is installed.
# FABLE_TESTCONTAINERS=0
