{
  "name": "@fable/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Independent BullMQ worker. Stub queue only. Cannot change balances.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fable/database": "workspace:*",
    "@fable/domain": "workspace:*",
    "@fable/observability": "workspace:*",
    "bullmq": "6.5.3"
  },
  "devDependencies": {
    "@fable/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  }
}
