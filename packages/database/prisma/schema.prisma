// FABLE ledger schema.
// There is no mutable balance column. Balances are derived from ledger_entries.
// Append-only rules are enforced again in SQL (see the init migration).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LedgerAccountType {
  USER_WALLET
  HOUSE
  PROVIDER_CLEARING
  SYSTEM

  @@map("ledger_account_type")
}

enum LedgerDirection {
  DEBIT
  CREDIT

  @@map("ledger_direction")
}

/// Player directory row. password_hash is a scrypt string, never a raw password.
/// There is still no payment profile and no real-money flag.
model User {
  id           String            @id @default(uuid()) @db.Uuid
  email        String            @unique
  displayName  String            @map("display_name")
  passwordHash String            @map("password_hash")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions     Session[]
  bets         DemoBet[]
  casinoRounds CasinoDemoRound[]

  @@map("users")
}

/// Server-side session. The cookie stores this id. The token is not a JWT in localStorage.
model Session {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String   @map("csrf_token")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("sessions")
}

/// Named account. Balance is not stored here.
model LedgerAccount {
  id        String              @id @db.Uuid
  code      String              @unique
  type      LedgerAccountType
  currency  String              @db.Char(3)
  userId    String?             @map("user_id") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  entries   LedgerEntry[]
  fence     LedgerAccountFence?

  @@index([userId])
  @@map("ledger_accounts")
}

/// MVCC conflict detection only. All balances still derive from immutable entries.
model LedgerAccountFence {
  accountId String        @id @map("account_id") @db.Uuid
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revision  BigInt        @default(0)

  @@map("ledger_account_fences")
}

/// One balanced journal. Idempotency key is unique. simulated is locked true in SQL.
model LedgerTransaction {
  id             String               @id @db.Uuid
  idempotencyKey String               @unique @map("idempotency_key")
  kind           String
  actorId        String?              @map("actor_id")
  simulated      Boolean              @default(true)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  postingXid     Unsupported("xid8")? @default(dbgenerated("pg_current_xact_id()")) @map("posting_xid")
  entries        LedgerEntry[]

  @@map("ledger_transactions")
}

/// Immutable double-entry line. No updatedAt. Updates and deletes are rejected by trigger.
model LedgerEntry {
  position      Int               @default(0)
  id            String            @id @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String            @map("account_id") @db.Uuid
  account       LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  direction     LedgerDirection
  amountMinor   BigInt            @map("amount_minor")
  currency      String            @db.Char(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

/// Append-only audit trail. Updates and deletes are rejected by trigger.
model AuditLog {
  id         String   @id @db.Uuid
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@map("audit_log")
}

model DemoBet {
  userId          String @map("user_id") @db.Uuid
  user            User   @relation(fields: [userId], references: [id])
  idempotencyKey  String @map("idempotency_key")
  fingerprint     String
  record          Json
  placementRecord Json   @map("placement_record")

  @@id([userId, idempotencyKey])
  @@map("demo_bets")
}

model CasinoDemoNamespace {
  singleton Boolean           @id @default(true)
  id        String            @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rounds    CasinoDemoRound[]

  @@map("casino_demo_namespace")
}

model CasinoDemoRound {
  id            String              @id @db.Uuid
  playerId      String              @map("player_id") @db.Uuid
  player        User                @relation(fields: [playerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  namespaceId   String              @map("namespace_id") @db.Uuid
  namespace     CasinoDemoNamespace @relation(fields: [namespaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startKey      String              @map("start_key") @db.VarChar(80)
  gameId        String              @map("game_id")
  gameKind      String              @map("game_kind")
  schemaVersion Int                 @map("schema_version") @db.SmallInt
  status        String
  revision      Int
  inputs        Json
  publicResult  Json                @map("public_result")
  privateMines  Json                @map("private_mines")
  createdAt     DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @map("updated_at") @db.Timestamptz(3)
  commands      CasinoDemoCommand[]

  @@unique([playerId, id])
  @@unique([playerId, startKey])
  @@index([playerId, gameId, createdAt(sort: Desc), id(sort: Desc)], map: "casino_demo_player_history")
  @@map("casino_demo_rounds")
}

model CasinoDemoCommand {
  playerId    String          @map("player_id") @db.Uuid
  requestKey  String          @map("request_key") @db.VarChar(80)
  roundId     String          @map("round_id") @db.Uuid
  round       CasinoDemoRound @relation(fields: [playerId, roundId], references: [playerId, id], onDelete: NoAction, onUpdate: NoAction)
  operation   String
  fingerprint String
  revision    Int
  response    Json
  createdAt   DateTime        @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)

  @@id([playerId, requestKey])
  @@unique([roundId, revision])
  @@map("casino_demo_commands")
}
