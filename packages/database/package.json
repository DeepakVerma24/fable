{
  "name": "@fable/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma client, Redis connections, and the ledger's Postgres store.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
    "migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@fable/domain": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ioredis": "6.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@fable/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "prisma": "7.10.1",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  }
}
